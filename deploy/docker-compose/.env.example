# Public name the hub is reached at (a DNS record pointing to this machine; ports 80 and 443 open for Let's Encrypt).
# DOMAIN=localhost works for a trial: Traefik then serves its own self-signed certificate.
DOMAIN=hermes.example.com
ACME_EMAIL=you@example.com

# openssl rand -hex 32   (setup.sh does this for you). Keep it: it encrypts the credentials in the database.
HUB_SECRET_KEY=

# the image tag of hermes-server
HERMES_VERSION=1.0.1
